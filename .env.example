# HikeReady environment variables
# ---------------------------------
# Copy this file to ".env" and fill in the real values.
#   PowerShell:  Copy-Item .env.example .env
# The real ".env" is gitignored and must never be committed.

# --- Database (Supabase / PostgreSQL) ---
# Used by Prisma. In Supabase: Project Settings -> Database -> Connection string.
# Use the "Connection pooling" (pooled) URL for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection, used by Prisma Migrate for schema changes.
# In Supabase this is the port 5432 connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth / client ---
# Project Settings -> API. The URL and anon key are safe to expose to the browser
# (hence the NEXT_PUBLIC_ prefix). The service role key is SECRET (server only).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --- App ---
# Base URL of the app, useful for auth redirects and API calls.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Razorpay (added later, safe to leave blank for now) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
